# Root Docker Compose configuration for exSoftOptic.
# Copy to .env and replace every production secret before deploying.

OPTICA_POSTGRES_USER=optica_user
OPTICA_POSTGRES_PASSWORD=change-me-postgres-password
OPTICA_POSTGRES_DB=optica_system

OPTICA_MONGO_USER=optica_admin
OPTICA_MONGO_PASSWORD=change-me-mongo-password
OPTICA_MONGO_DB=optica_clinico

DATABASE_URL=postgresql+asyncpg://optica_user:change-me-postgres-password@postgres:5432/optica_system
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
MONGODB_URL=mongodb://optica_admin:change-me-mongo-password@mongodb:27017/optica_clinico?authSource=admin

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-me-generate-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://app.example.com"]

# Empty keeps the frontend using the Nginx reverse proxy (/api -> backend).
VITE_API_BASE_URL=
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
