# Root Docker Compose configuration for exSoftOptic.
# Copy to .env and replace every production secret before deploying.

OPTICA_POSTGRES_USER=optica_user
OPTICA_POSTGRES_PASSWORD=change-me-postgres-password
OPTICA_POSTGRES_DB=optica_system

OPTICA_MONGO_USER=optica_admin
OPTICA_MONGO_PASSWORD=change-me-mongo-password
OPTICA_MONGO_DB=optica_clinico

SECRET_KEY=change-me-generate-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Empty keeps the frontend using the Nginx reverse proxy (/api -> backend).
VITE_API_BASE_URL=
